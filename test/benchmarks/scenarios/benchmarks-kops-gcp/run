# benchmark-kops-gcp runs benchmarks against a kOps cluster on GCP.

set -o errexit
set -o nounset
set -o pipefail

# Start in the root of the repository.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

export WORKDIR="${REPO_ROOT}/.build"
rm -rf "${WORKDIR}"
mkdir -p "${WORKDIR}/bin"

export BINDIR="${WORKDIR}/bin"
export PATH="${BINDIR}:${PATH}"

export KUBECONFIG="${WORKDIR}/kubeconfig"

# Install kOps to bin dir
echo "Installing kOps to ${BINDIR}..."
GOBIN="${BINDIR}" go install k8s.io/kops/cmd/kops@v1.35.0

# Install resourcectl to bin dir
echo "Installing resourcectl to ${BINDIR}..."
pushd dev/tools
GOBIN="${BINDIR}" go install ./resourcectl
popd

UNIQUE_SUFFIX="$(date +%Y%m%d-%H%M%S)"

# Get project info from boskos if available, otherwise use the default project.
if [[ -n "${BOSKOS_HOST:-}" ]]; then
  if ! PROJECT_ID=$(resourcectl get --key project-main --boskos-type gce-project); then
    echo "Failed to acquire project from Boskos"
    exit 1
  fi
  echo "Acquired project ${PROJECT_ID} from Boskos."
else
  PROJECT_ID=$(gcloud config get-value project)
fi

PROJECT_NUMBER=$(gcloud projects describe "${PROJECT_ID}" --format="value(projectNumber)")
echo "Using project: ${PROJECT_ID} (number: ${PROJECT_NUMBER})"

IMAGE_PREFIX="gcr.io/${PROJECT_ID}/agent-sandbox/"
export IMAGE_PREFIX
echo "Using image prefix: ${IMAGE_PREFIX}"

# Configure Docker to use gcloud credential helper for gcr.io
gcloud auth configure-docker --quiet gcr.io

# We don't set up registry permissions here because Boskos does not allow
# configuring IAM permissions on the project. The kOps cluster is configured
# to use the default compute service account, which has access by default.

# Compute image tag based on the git tag
IMAGE_TAG=$(git describe --tags --dirty --always)
# Add a timestamp if it's dirty
if [[ "${IMAGE_TAG}" == *"-dirty" ]]; then
  IMAGE_TAG="${IMAGE_TAG}-${UNIQUE_SUFFIX}"
fi
export IMAGE_TAG
echo "Using image tag: ${IMAGE_TAG}"

# Push images
for image in "agent-sandbox-controller" "chrome-sandbox"; do
  echo "Pushing ${image} to ${IMAGE_PREFIX}..."
  dev/tools/push-images --image-prefix="${IMAGE_PREFIX}" --images "${image}"
done


BUCKET_NAME="kops-state-${PROJECT_NUMBER}"
echo "Using bucket: ${BUCKET_NAME}"

# Create state store bucket if not exists
if ! gcloud storage buckets describe "gs://${BUCKET_NAME}" >/dev/null 2>&1; then
  echo "Creating bucket gs://${BUCKET_NAME}..."
  gcloud storage buckets create "gs://${BUCKET_NAME}" --project="${PROJECT_ID}" --location=us-central1
else
  echo "Bucket gs://${BUCKET_NAME} already exists."
fi

export KOPS_STATE_STORE="gs://${BUCKET_NAME}"

# Compute a relatively unique identifier for this run to allow concurrent runs.
# EXISTING_CLUSTER reuses a cluster left behind by a previous KEEP_CLUSTER=true
# run: cluster creation, validation, and the cilium tuning are skipped (they
# are one-time per cluster), and only deploy + stress run.
CLUSTER_NAME="${EXISTING_CLUSTER:-sandbox-${UNIQUE_SUFFIX}}"
ZONE="us-central1-a"

cleanup() {
  echo "Cleaning up..."

  # KEEP_CLUSTER=true leaves the cluster running for reuse by a subsequent
  # run (pass its name via EXISTING_CLUSTER). Remember to delete it manually.
  if [[ "${KEEP_CLUSTER:-false}" == "true" ]]; then
    echo "KEEP_CLUSTER=true: leaving cluster ${CLUSTER_NAME} running."
  else
    kops delete cluster --name="${CLUSTER_NAME}" --yes || true
  fi
  # By default we don't delete the bucket, so that we can run parallel tests.
  if [[ "${CLEANUP_BUCKET:-false}" == "true" ]]; then
    echo "Deleting bucket gs://${BUCKET_NAME}..."
    gcloud storage buckets delete "gs://${BUCKET_NAME}" --quiet || true
  fi

  echo "Cleaning up resources via resourcectl..."
  resourcectl cleanup || true

  rm -rf "${WORKDIR}"
  echo "DONE"
}

trap cleanup EXIT

# CNI selects the cluster networking (any kOps --networking value; we
# exercise cilium and kindnet in CI). Running the same benchmark under two
# CNIs separates CNI costs from the rest of the sandbox launch pipeline.
CNI="${CNI:-cilium}"
echo "Using CNI: ${CNI}"

# NODE_COUNT sizes the worker node group. The default 3 n2-standard-8 nodes
# give ~330 pod slots (110/node) minus system pods — enough for the default
# stress phases, but VERY tight for claims-warm at 300 (the warm pool needs
# 300 pods, and pool replenishment can transiently push toward 600). Bump
# NODE_COUNT (e.g. 6) when running claims-warm at full size.
NODE_COUNT="${NODE_COUNT:-3}"
echo "Using node count: ${NODE_COUNT}"

# CONTROLLER_ARGS injects extra agent-sandbox-controller flags via
# deploy-to-kube --controller-args. Empty by default (stock controller
# configuration). Recommended flags for claim-burst perf runs:
#   CONTROLLER_ARGS="--kube-api-qps=1000 --kube-api-burst=2000 \
#     --sandbox-concurrent-workers=400 --sandbox-claim-concurrent-workers=400 \
#     --sandbox-warm-pool-concurrent-workers=1 --enable-webhook=false \
#     --enable-pprof-debug --zap-log-level=debug"
# (high QPS/workers remove client-side throttling from the claim path;
# warm-pool workers=1 keeps pool replenishment from competing with claim
# binding during the burst; --enable-webhook=false skips webhook cert
# bootstrap, safe now that no conversion webhook exists;
# --enable-pprof-debug exposes the heap/goroutine/block/mutex pprof
# endpoints the stress tool captures during claims-warm; --zap-log-level=debug
# enables the per-claim "adoption timing" debug lines in controller.log.)
CONTROLLER_ARGS="${CONTROLLER_ARGS:-}"

# INSTRUMENT_CLUSTER=true (default false) trades some apiserver overhead for
# diagnostic signal on perf-investigation runs: it raises kube-apiserver log
# verbosity to 3 (per-request handler timing lines) at cluster CREATION time,
# and captures the apiserver container logs into $ARTIFACTS at the end.
#
# NOTE on audit logging: kops v1.35 only supports audit via
# cluster.spec.kubeAPIServer.auditPolicyFile, which must point at a policy
# file already present on the control-plane host, provisioned through
# cluster.spec.fileAssets (a list of structured objects that cannot be
# expressed reliably through repeated `kops create cluster --set key=value`
# flags). A malformed audit wiring prevents kube-apiserver from starting at
# all, so audit capture is deliberately NOT attempted here: the risk to
# cluster bring-up outweighs the extra signal. Write-path timing is covered
# instead by apiserver_request_duration_seconds (already scraped) plus the
# verbosity raised above.
INSTRUMENT_CLUSTER="${INSTRUMENT_CLUSTER:-false}"

# CP_MACHINE_TYPE (default n2-standard-8) sets the control-plane instance
# size. Round-3 forensics measured the apiserver's own request EXECUTION time
# inflating ~3-10x during the 300-claim burst (apf execution p50 86ms / p90
# 321ms for the agent-sandbox-critical priority level vs ~30ms quiescent etcd
# commits) — the control-plane box is CPU-bound at burst peak. Larger types
# (n2-standard-16/32) are needed for the 500-1000 claims/s targets.
CP_MACHINE_TYPE="${CP_MACHINE_TYPE:-n2-standard-8}"

# TUNE_CONTROL_PLANE=true (default false, INSTRUMENT_CLUSTER-style opt-in)
# raises the control-plane component limits that round-3 identified as the
# burst throughput governors. Applied only at cluster CREATION time (same
# limitation as INSTRUMENT_CLUSTER: reused clusters keep their settings).
#
#   kube-apiserver seats: --max-mutating-requests-inflight defaults to 200
#     and --max-requests-inflight to 400 → 600 APF seats total. Our two
#     dedicated priority levels (k8s/apf-insulation.yaml) get shares of that
#     total: agent-sandbox-critical 40/310 ≈ 78 seats — and round-3 leg B
#     measured a demand high-watermark of 272 seats against those 78 during
#     the burst (APF wait p90 63ms / p99 359ms on our own PL). Raising to
#     1000 mutating / 3000 read-only gives 4000 seats; the PL shares are
#     FRACTIONS, so critical scales to ~516 seats and bulk to ~322 with no
#     manifest change (see the sizing note in k8s/apf-insulation.yaml).
#   kube-scheduler QPS: default 50/100 caps pod-refill throughput; 800/1600
#     keeps the scheduler off the critical path at 1000 pods/s of pool churn.
#   kube-controller-manager QPS: default 20 makes the EndpointSlice and GC
#     controllers fall behind per-sandbox Service churn by design; 200/400
#     keeps teardown/refill from backlogging into the next burst.
#
# etcd note: kops already provisions SEPARATE main and events etcd clusters
# by default (etcd-events), so the "--etcd-servers-overrides=/events#..."
# split from the scale roadmap is in place without extra flags here. Further
# splits (pods / our CR groups onto more etcd clusters) need cluster-spec
# surgery and are deliberately out of scope for this knob.
TUNE_CONTROL_PLANE="${TUNE_CONTROL_PLANE:-false}"

if [[ -z "${EXISTING_CLUSTER:-}" ]]; then

echo "Creating kOps cluster configuration..."
# --gce-service-account=default: needed because boskos doesn't let us configure IAM permissions on the project.
#
# authorizationAlwaysAllowPaths: allow unauthenticated GETs of /metrics on
# kube-controller-manager and kube-scheduler so the stress test can scrape
# them through the apiserver pod proxy (the apiserver strips the
# Authorization header after authenticating, so the proxied request is
# anonymous and the default delegated authorization rejects it with 403).
# The health probe paths must be repeated because setting the field replaces
# the upstream default, and kOps liveness probes hit /healthz.
# Ports 10257/10259 are not internet-reachable: kOps GCE creates a
# deny-by-default VPC and only control-plane instances can reach them.
#
# cilium.enablePrometheusMetrics: serve cilium-agent metrics on :9090 so the
# stress test can scrape them (promscrape.go already targets this port; the
# 2077449092094496768 run showed pod-sandbox creation as the launch
# bottleneck, and CNI endpoint regeneration latency lives in these metrics).
# Only set when cilium is the CNI: the --set alone materializes a
# spec.networking.cilium section, and kOps rejects a cluster with two
# networking options.
CNI_KOPS_FLAGS=()
if [[ "${CNI}" == "cilium" ]]; then
    CNI_KOPS_FLAGS+=("--set" "cluster.spec.networking.cilium.enablePrometheusMetrics=true")
fi
INSTRUMENT_KOPS_FLAGS=()
if [[ "${INSTRUMENT_CLUSTER}" == "true" ]]; then
    # kube-apiserver -v=3 logs per-request completion lines (verb, URI,
    # latency, status) without the firehose of -v=4+. See INSTRUMENT_CLUSTER
    # comment above for why audit logging is not enabled.
    echo "INSTRUMENT_CLUSTER=true: raising kube-apiserver log verbosity to 3"
    INSTRUMENT_KOPS_FLAGS+=("--set" "cluster.spec.kubeAPIServer.logLevel=3")
fi
TUNE_KOPS_FLAGS=()
if [[ "${TUNE_CONTROL_PLANE}" == "true" ]]; then
    # See the TUNE_CONTROL_PLANE comment above for the sizing rationale.
    echo "TUNE_CONTROL_PLANE=true: raising apiserver inflight limits and scheduler/KCM client QPS"
    TUNE_KOPS_FLAGS+=(
      "--set" "cluster.spec.kubeAPIServer.maxRequestsInflight=3000"
      "--set" "cluster.spec.kubeAPIServer.maxMutatingRequestsInflight=1000"
      "--set" "cluster.spec.kubeScheduler.kubeAPIQPS=800"
      "--set" "cluster.spec.kubeScheduler.kubeAPIBurst=1600"
      "--set" "cluster.spec.kubeControllerManager.kubeAPIQPS=200"
      "--set" "cluster.spec.kubeControllerManager.kubeAPIBurst=400"
    )
fi
kops create cluster \
  --cloud=gce \
  --gce-service-account=default \
  --networking="${CNI}" \
  --name="${CLUSTER_NAME}" \
  --zones="${ZONE}" \
  --project="${PROJECT_ID}" \
  --control-plane-count=1 \
  --control-plane-size="${CP_MACHINE_TYPE}" \
  --node-count="${NODE_COUNT}" \
  --node-size=n2-standard-8 \
  --set cluster.spec.kubeControllerManager.authorizationAlwaysAllowPaths=/healthz \
  --set cluster.spec.kubeControllerManager.authorizationAlwaysAllowPaths=/readyz \
  --set cluster.spec.kubeControllerManager.authorizationAlwaysAllowPaths=/livez \
  --set cluster.spec.kubeControllerManager.authorizationAlwaysAllowPaths=/metrics \
  --set cluster.spec.kubeScheduler.authorizationAlwaysAllowPaths=/healthz \
  --set cluster.spec.kubeScheduler.authorizationAlwaysAllowPaths=/readyz \
  --set cluster.spec.kubeScheduler.authorizationAlwaysAllowPaths=/livez \
  --set cluster.spec.kubeScheduler.authorizationAlwaysAllowPaths=/metrics \
  ${CNI_KOPS_FLAGS[@]+"${CNI_KOPS_FLAGS[@]}"} \
  ${INSTRUMENT_KOPS_FLAGS[@]+"${INSTRUMENT_KOPS_FLAGS[@]}"} \
  ${TUNE_KOPS_FLAGS[@]+"${TUNE_KOPS_FLAGS[@]}"}

echo "Applying cluster configuration..."
kops update cluster --name "${CLUSTER_NAME}" --yes

echo "Exporting kubeconfig..."
kops export kubeconfig --name "${CLUSTER_NAME}" --admin

echo "Waiting for cluster to be ready..."
kops validate cluster --wait 20m

if [[ "${CNI}" == "cilium" ]]; then
  # Raise Cilium's endpoint-create API rate limit. The agent rate-limits
  # endpoint creation (the synchronous PUT /v1/endpoint the CNI plugin makes
  # during every pod sandbox creation) to 0.5/s with auto-adjustment anchored
  # to a 2s estimated processing duration. Under churn, queueing pushes mean
  # processing toward that anchor, so the auto-adjusted limit converges to
  # ~2 creates/s per node while actual endpoint work takes ~100ms — capping
  # pod launch throughput at the limiter, not the datapath (see the stress
  # report's Cilium page, e.g. run 2077526390265090048: 20.8s mean limiter
  # wait vs 1.6s processing at throughput-mif200). Raise the limits and
  # disable auto-adjustment so the stress test measures the CNI datapath's
  # real capacity; kOps applies its addons at bootstrap, so this patch is not
  # reverted during the run.
  echo "Raising Cilium endpoint-create API rate limits..."
  # k8s-client-qps/burst: with the endpoint-create limiter raised, the next
  # cork is cilium-agent's client-go QPS limit (default 5/s, burst 10): run
  # 2077921435870826496 showed ~0.4s of client-side throttle wait per POST and
  # ~1.4s per DELETE to the apiserver during churn, ~7s per endpoint create in
  # total, while the apiserver itself answered in ~20ms.
  kubectl --namespace kube-system patch configmap cilium-config --type merge \
    --patch '{"data":{"api-rate-limit":"endpoint-create=rate-limit:100/s,rate-burst:100,parallel-requests:32,auto-adjust:false","k8s-client-qps":"50","k8s-client-burst":"100"}}'
  # kOps deploys the cilium DaemonSet with updateStrategy=OnDelete, so
  # "rollout restart" never recreates the pods (and "rollout status" errors
  # out). Delete the agent pods so the DaemonSet brings them back with the
  # new config, then re-validate the cluster to wait for them to be Ready.
  kubectl --namespace kube-system delete pods --selector=k8s-app=cilium
  kops validate cluster --wait 10m
fi

else
  echo "Reusing existing cluster ${CLUSTER_NAME} (skipping create/validate/cilium tuning)..."
  if [[ "${INSTRUMENT_CLUSTER}" == "true" ]]; then
    echo "NOTE: INSTRUMENT_CLUSTER=true only raises apiserver verbosity at cluster creation;"
    echo "the reused cluster keeps whatever verbosity it was created with (apiserver log capture still runs)."
  fi
  if [[ "${TUNE_CONTROL_PLANE}" == "true" ]]; then
    echo "NOTE: TUNE_CONTROL_PLANE=true only applies at cluster creation; the reused cluster"
    echo "keeps its original apiserver inflight limits and scheduler/KCM QPS settings."
  fi
  kops export kubeconfig --name "${CLUSTER_NAME}" --admin
fi

# Deploy to cluster
echo "Deploying to cluster..."
DEPLOY_FLAGS=(--image-prefix="${IMAGE_PREFIX}" --extensions)
if [[ -n "${CONTROLLER_ARGS}" ]]; then
  echo "Injecting controller args: ${CONTROLLER_ARGS}"
  DEPLOY_FLAGS+=(--controller-args "${CONTROLLER_ARGS}")
fi
dev/tools/deploy-to-kube "${DEPLOY_FLAGS[@]}"

# Wait for controller to be ready
echo "Waiting for controller to be ready..."
kubectl rollout status deployment agent-sandbox-controller --namespace agent-sandbox-system --timeout=10m

# Run the benchmarks
# SKIP_E2E_SUITE=true skips the Go/Python e2e benchmark suite (which requires a
# working pip index for the Python SDK) and proceeds straight to the stress
# test, which is pure Go.
if [[ "${SKIP_E2E_SUITE:-false}" == "true" ]]; then
  echo "Skipping e2e benchmark suite (SKIP_E2E_SUITE=true)."
else
  echo "Running benchmarks..."
  dev/tools/test-e2e --suite=benchmarks --image-prefix="${IMAGE_PREFIX}"
  echo "Benchmark completed successfully."
fi


# Run the stress test.
#
# Phases are a comma-separated list of names (see test/stress/main.go):
#   fill              long-running background sandboxes (scale)
#   probe             low-concurrency launch latency
#   claims-warm       N simultaneous SandboxClaims against a pre-provisioned
#                     warm pool of N (measures claim -> Ready binding latency;
#                     needs the extensions controller, deployed above)
#   throughput-mifN   closed-loop churn capped at N in-flight
#
# Keep fill (fill-per-node * nodes) + max(mifN, claims-warm count) below
# spare pod capacity (roughly NODE_COUNT * 110 minus system pods); the test
# refuses to run if they don't fit. claims-warm additionally causes pool
# replenishment (up to ~2x its count transiently); the tool warns when that
# overshoots. E.g. STRESS_CLAIMS_WARM=300 wants NODE_COUNT>3.
# Defaults below are sized for the default 3-node cluster; claims-warm is
# opt-in via STRESS_PHASES (e.g. STRESS_PHASES=claims-warm STRESS_CLAIMS_WARM=300).
STRESS_OUTPUT_DIR="${ARTIFACTS:-.}/stress-test/"
mkdir -p "${STRESS_OUTPUT_DIR}"

capture_stress_diagnostics() {
  echo "Capturing controller diagnostics..."
  kubectl logs deployment/agent-sandbox-controller --namespace agent-sandbox-system --tail=-1 > "${STRESS_OUTPUT_DIR}/controller.log" || true
  kubectl get pods -A -o wide > "${STRESS_OUTPUT_DIR}/pods.txt" || true
  kubectl get nodes -o wide > "${STRESS_OUTPUT_DIR}/nodes.txt" || true
  kubectl top nodes > "${STRESS_OUTPUT_DIR}/top-nodes.txt" 2>/dev/null || true

  # Headless apiserver log capture: kubectl logs on the static apiserver
  # pod(s) works with just the admin kubeconfig (no SSH to the control-plane
  # node needed, unlike kops toolbox dump). At logLevel=3 the interesting
  # content is per-request completion lines; kubelet log rotation bounds the
  # size, so this is the tail of the run, which covers the stress phases.
  if [[ "${INSTRUMENT_CLUSTER}" == "true" ]]; then
    echo "Capturing kube-apiserver logs (INSTRUMENT_CLUSTER=true)..."
    for pod in $(kubectl get pods --namespace kube-system --selector=k8s-app=kube-apiserver -o name); do
      kubectl logs --namespace kube-system "${pod}" --tail=-1 > "${STRESS_OUTPUT_DIR}/${pod#pod/}.log" || true
    done
  fi
}

# STRESS_SMOKE_COUNT (default 0 = off) runs a small claims-warm first as a
# pipeline smoke test; under errexit a smoke failure aborts before the
# expensive full-size run.
if [[ "${STRESS_SMOKE_COUNT:-0}" -gt 0 ]]; then
  echo "Running smoke claims-warm (count=${STRESS_SMOKE_COUNT})..."
  go run ./test/stress \
    --phases=claims-warm \
    --claims-warm-count="${STRESS_SMOKE_COUNT}" \
    --timeout=10m \
    --output-dir="${STRESS_OUTPUT_DIR}/smoke"
  echo "Smoke test passed."
fi

echo "Running stress test"
# Prometheus metrics from the apiserver, kube-controller-manager,
# kube-scheduler, the sandbox controller, and kubelets are collected by the
# stress tool itself (metrics.jsonl.gz; see --collect-metrics).
set +o errexit
go run ./test/stress \
  --phases="${STRESS_PHASES:-fill,probe,throughput-mif200,throughput-mif100,throughput-mif50}" \
  --fill-per-node="${STRESS_FILL_PER_NODE:-10}" \
  --probe-count="${STRESS_PROBE_COUNT:-30}" \
  --throughput-count="${STRESS_THROUGHPUT_COUNT:-500}" \
  --throughput-min-seconds="${STRESS_THROUGHPUT_MIN_SECONDS:-45}" \
  --claims-warm-count="${STRESS_CLAIMS_WARM:-300}" \
  --create-concurrency="${STRESS_CREATE_CONCURRENCY:-50}" \
  --timeout="${STRESS_TIMEOUT:-30m}" \
  --output-dir="${STRESS_OUTPUT_DIR}" \
  ${STRESS_EXTRA_ARGS:-}
stress_status=$?
set -o errexit
capture_stress_diagnostics

# Generate stress test report, under the stress-test artifacts dir (the
# report is part of the stress test, alongside the raw data it renders).
REPORT_OUTPUT_DIR="${STRESS_OUTPUT_DIR}/report"
echo "Generating stress test report to ${REPORT_OUTPUT_DIR}..."
if python3 -c "import venv" >/dev/null 2>&1; then
  python3 -m venv "${BINDIR}/report-venv"
  "${BINDIR}/report-venv/bin/pip" install --quiet 'duckdb>=1,<2' 'jinja2>=3,<4'
  "${BINDIR}/report-venv/bin/python3" test/stress/generate-report/generate_report.py \
    --input-dir "${STRESS_OUTPUT_DIR}" \
    --output-dir "${REPORT_OUTPUT_DIR}"
  echo "Report generated successfully."
  # Surface a direct link on the prow job page: spyglass's links lens
  # renders artifacts/*.link.txt files (content: a URL) as clickable links,
  # so the report is reachable from the PR's Details link without digging
  # through the artifacts browser.
  #
  # Write a gs:// URL rather than an https:// one on purpose: the links lens
  # sends https:// links through a https://google.com/url?q= redirect (to
  # strip referer), which shows an interstitial. gs:// links instead go
  # straight to the configured GCS browser (gcsweb.k8s.io), which 307s a
  # file URL to storage.googleapis.com and renders it -- no interstitial.
  if [[ -n "${ARTIFACTS:-}" && -n "${JOB_NAME:-}" && -n "${BUILD_ID:-}" ]]; then
    if [[ -n "${PULL_NUMBER:-}" ]]; then
      JOB_GCS_PATH="pr-logs/pull/${REPO_OWNER:-kubernetes-sigs}_${REPO_NAME:-agent-sandbox}/${PULL_NUMBER}/${JOB_NAME}/${BUILD_ID}"
    else
      JOB_GCS_PATH="logs/${JOB_NAME}/${BUILD_ID}"
    fi
    REPORT_PATH="kubernetes-ci-logs/${JOB_GCS_PATH}/artifacts/stress-test/report/index.html"
    # Filename sets the link's display text (the links lens title-cases it):
    # stress-test.link.txt -> "Stress test".
    echo "gs://${REPORT_PATH}" > "${ARTIFACTS}/stress-test.link.txt"
    # Echo the direct https URL for copy-paste from the build log.
    echo "Stress test report: https://storage.googleapis.com/${REPORT_PATH}"
  fi
else
  echo "Warning: python3 venv module not available, skipping report generation."
fi

if [[ "${stress_status}" -ne 0 ]]; then
  exit "${stress_status}"
fi
echo "Stress test completed successfully."
